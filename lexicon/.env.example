# Copy to lexicon/.env and fill in. Never commit .env; keys never go into
# code or the database.

# PostgreSQL (the `lexicon` role owns the `lexicon` and `lexicon_test` databases)
LEXICON_DB_HOST=127.0.0.1
LEXICON_DB_PORT=5432
LEXICON_DB_USER=lexicon
LEXICON_DB_PASSWORD=change-me
LEXICON_DB_NAME=lexicon
# Or give full URLs instead:
# LEXICON_DATABASE_URL=postgresql+psycopg://lexicon:change-me@127.0.0.1:5432/lexicon
# LEXICON_TEST_DATABASE_URL=postgresql+psycopg://lexicon:change-me@127.0.0.1:5432/lexicon_test

# Only used by docker-compose.yml for the postgres superuser
POSTGRES_SUPERPASSWORD=change-me-too

# The admin API (127.0.0.1:8770). Every request needs X-API-Key: <this>.
LEXICON_API_KEY=generate-a-long-random-string
LEXICON_API_PORT=8770

# AI 翻譯 fallback: the local tagging service (tagger/tagging_server.py)
LEXICON_AI_URL=http://127.0.0.1:8765
LEXICON_AI_KEY=the-tagger-api-key

# Optional locations (defaults: lexicon/raw-data, lexicon/media, lexicon/exports)
# LEXICON_RAW_DATA=
# LEXICON_MEDIA=
# LEXICON_EXPORTS=
